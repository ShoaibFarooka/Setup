# Server
NODE_ENV=development
PORT=5000
# 127.0.0.1 = only this computer can reach the API. Use 0.0.0.0 only if other devices must connect.
HOST=127.0.0.1
# Number of proxies in front of the server (e.g. 1 behind Nginx, a load balancer or a hosting platform); 0 = none.
# Needed so rate limiting sees each visitor's real IP instead of the proxy's.
TRUST_PROXY=0
# Origins (front-end URLs) allowed to call the API, comma-separated, no trailing slash.
# Not set: http://localhost:5200 in development, none in production.
CORS_ORIGINS=http://localhost:5200

# fatal, error, warn, info, debug, trace or silent. Not set: debug in development, info in production
LOG_LEVEL=

# Database
DB_URI=mongodb://127.0.0.1:27017/db_name

# Auth: random strings of at least 32 characters, different from each other (required, the server will not start without them)
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY_TIME=5m
REFRESH_TOKEN_EXPIRY_TIME=7d

# Admin account created by: npm run seed
ADMIN_NAME=Admin
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (optional): the settings below are required only when EMAIL_ENABLED=true
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
# true for port 465, false for 587 (STARTTLS)
EMAIL_SECURE=false
SENDER_EMAIL=
SENDER_EMAIL_PASSWORD=
