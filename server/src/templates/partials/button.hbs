{{!-- {{> button url=resetUrl label="Reset password"}}: a link that looks like a button in every email program --}}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0;">
    <tr>
        <td style="border-radius:8px;background-color:#4F46E5;">
            <a href="{{url}}" style="display:inline-block;padding:12px 24px;font-size:16px;font-weight:bold;color:#FFFFFF;text-decoration:none;">{{label}}</a>
        </td>
    </tr>
</table>
